// Mutual recursion: is_even calls is_odd and vice versa.
// Both functions must be visible regardless of declaration order.

bool is_even(int n) {
  if (n == 0) return true;
  return is_odd(n - 1);
}

bool is_odd(int n) {
  if (n == 0) return false;
  return is_even(n - 1);
}

void main() {
  for (int i = 0; i < 6; i = i + 1) {
    if (is_even(i)) print(i);
  }
}
